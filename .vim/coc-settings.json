{
    "css.completion.completePropertyWithSemicolon": true,
    "javascript.suggest.completeFunctionCalls": true,
    "suggest.insertMode": "replace",
    "suggest.enableFloat": true,
    "json.format.enable": true,
    "javascript.suggest.names": true,
    "javascript.suggest.enabled": true,
    "javascript.suggest.paths": true,
    "tsserver.enable": true,
    "typescript.suggest.paths": true,
    "javascript.suggest.autoImports": true,
    "javascript.format.semicolons": "insert",
    "javascript.format.enable": true,
    "javascript.format.insertSpaceBeforeFunctionParenthesis": true,
    "javascript.format.insertSpaceAfterKeywordsInControlFlowStatements": true,
    "javascript.format.placeOpenBraceOnNewLineForFunctions": false,
    "javascript.preferences.quoteStyle": "double",
    "eslint.useFlatConfig": true,
    "eslint.run": "onSave",
    "eslint.packageManager": "yarn",
    "eslint.workingDirectories": [{"directory": "~/libby-userscript", "!cwd": true},],
    "eslint.codeAction.disableRuleComment": {
        "enable": true,
        "location": "separateLine"
    },
    "eslint.format.enable": false,
    "eslint.lintTask.command": "eslint_d",
    "eslint.onIgnoredFiles": "off",
    "codeLens.position": "top",
    "codeLens.display": true,
    "codeLens.enable": true,
    "codeLens.separator": "",
    "javascript.referencesCodeLens.enabled": true,
    "codeLens.subseparator": " | ",
    "json.enable": true,
    "json.validate.trailingCommas": "warning",
    "javascript.inlayHints.variableTypes.enabled": true

}
